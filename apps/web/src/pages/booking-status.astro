---
import Base from '../layouts/Base.astro';
import BookingStatus from '../components/booking/BookingStatus.tsx';

const title = 'Track Your Booking — Cinematic Celebration';
const description =
  'Check the status and payment details of your Cinematic Celebration booking using your booking token.';
---

<Base title={title} description={description}>
  <section class="bg-festive-animated -mx-4 rounded-3xl px-6 py-10 text-center text-white shadow-lg">
    <h1 class="text-3xl font-extrabold drop-shadow sm:text-4xl">Your booking</h1>
    <p class="mx-auto mt-3 max-w-xl text-white/90">
      Status and payment details are looked up by your booking token.
    </p>
  </section>
  <div class="mt-8">
    <!-- Reads ?token= from the URL and fetches status at runtime. -->
    <BookingStatus client:load />
  </div>
</Base>
