---
import Base from '../layouts/Base.astro';

const title = 'Terms & Conditions — Cinematic Celebration';
const description =
  'Terms and conditions for booking a private theatre celebration with Cinematic Celebration, Bangalore.';
---

<Base title={title} description={description}>
  <section class="bg-festive-animated -mx-4 rounded-3xl px-6 py-10 text-center text-white shadow-lg">
    <h1 class="text-3xl font-extrabold drop-shadow sm:text-4xl">Terms &amp; Conditions</h1>
  </section>

  <article class="mx-auto mt-8 max-w-3xl space-y-4 rounded-2xl bg-white p-6 text-gray-700 shadow-sm sm:p-8">
    <p>
      By making a booking with Cinematic Celebration, you agree to abide by these
      terms and conditions. Failure to comply may result in expulsion from the
      event premises without a refund. We appreciate your cooperation in ensuring
      a safe and enjoyable event for all attendees.
    </p>

    <div>
      <h2 class="font-semibold text-gray-900">Age restriction</h2>
      <p>
        All event bookings require attendees to be aged 18 or older. Bookings made
        for individuals below the age of 18 will not be accepted, and no refunds
        will be issued.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Guest eligibility</h2>
      <p>
        Cinematic Celebration welcomes bookings from couples, women's groups, and
        a mix of women and men. Bookings for other configurations may not be
        accepted.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Prohibited substances</h2>
      <p>
        The use of tobacco and alcohol within the event premises is strictly
        prohibited. Guests found engaging in such activities will be expelled from
        the premises.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Additional decorations</h2>
      <p>
        No additional decor items such as party poppers, fireworks, or flyers are
        allowed without prior approval from Cinematic Celebration.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Identification requirement</h2>
      <p>
        Guests are required to present government-approved identification cards
        during the check-in process.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Booking duration</h2>
      <p>
        Guests are expected to adhere to the stipulated hours of booking. No
        additional time will be granted beyond the agreed-upon duration.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Booking changes</h2>
      <p>
        Any changes to event bookings must be communicated to Cinematic
        Celebration at least 3 days in advance. Failure to do so may result in the
        forfeiture of the booking amount.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Prohibited activities</h2>
      <p>
        Public displays of affection (PDA) and any form of sexual activity are
        strictly prohibited on the premises. Guests found engaging in such
        activities will be expelled from the premises.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Parking</h2>
      <p>
        Cinematic Celebration does not provide on-site parking facilities. Guests
        are responsible for their own parking arrangements, and parking is
        entirely at their own risk.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Booking cancellation</h2>
      <p>
        Cinematic Celebration reserves the right to cancel bookings in the event
        of unforeseen circumstances. In such cases, the booking amount will be
        refunded within 10 working days.
      </p>
    </div>
  </article>
</Base>
