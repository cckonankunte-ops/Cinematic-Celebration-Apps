---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/booking/ContactForm.tsx';

const title = 'Contact Us — Cinematic Celebration Bangalore';
const description =
  'Have a question about booking a private theatre celebration? Send us a message and our Bangalore team will get back to you.';
---

<Base title={title} description={description}>
  <h1 class="text-3xl font-bold">Contact us</h1>
  <p class="mt-2 text-gray-600">
    Questions about plans, availability, or add-ons? Drop us a message.
  </p>
  <div class="mt-8 max-w-xl">
    <ContactForm client:visible />
  </div>
</Base>
