---
import Base from '../layouts/Base.astro';

const title = 'Refund Policy — Cinematic Celebration';
const description =
  'Refund and cancellation policy for bookings with Cinematic Celebration, Bangalore.';
---

<Base title={title} description={description}>
  <section class="bg-festive-animated -mx-4 rounded-3xl px-6 py-10 text-center text-white shadow-lg">
    <h1 class="text-3xl font-extrabold drop-shadow sm:text-4xl">Refund Policy</h1>
  </section>

  <article class="mx-auto mt-8 max-w-3xl space-y-4 rounded-2xl bg-white p-6 text-gray-700 shadow-sm sm:p-8">
    <p>
      We understand that unforeseen circumstances may require you to cancel your
      booking. To ensure transparency and provide clear guidelines, we have
      established the following refund policy.
    </p>

    <div>
      <h2 class="font-semibold text-gray-900">Refund process</h2>
      <p>
        If you choose to cancel your booking, you are eligible for a refund when
        the cancellation occurs more than 48 hours before the scheduled event.
        Once approved, your refund will be processed and a credit automatically
        applied to your original method of payment within 7–9 days.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Cancellation policy</h2>
      <p>
        In the event that you need to cancel your booking within 24 hours of the
        scheduled event, we regret to inform you that we cannot offer refunds or
        rescheduling options.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-gray-900">Cancellation by Cinematic Celebration</h2>
      <p>
        If Cinematic Celebration needs to cancel a booking with less than 48
        hours' notice, we will reschedule the event for you without any additional
        charges, subject to availability.
      </p>
    </div>

    <p>
      If you have any questions or concerns, please feel free to reach out to us
      for assistance. Your satisfaction is important to us, and we are here to
      help.
    </p>
  </article>
</Base>
