---
import Base from '../layouts/Base.astro';
import BranchPreview from '../components/booking/BranchPreview.tsx';

const title = 'Cinematic Celebration — Private Theatre Celebrations in Bangalore';
const description =
  'Celebrate birthdays, anniversaries, bride-to-be, groom-to-be and every occasion in a private theatre with curated decoration themes across our Bangalore branches. Pick a branch, choose a theme and slot, add a cake, and book online.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Cinematic Celebration',
  description,
  url: 'https://cinematiccelebration.in',
  areaServed: 'Bangalore',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bangalore',
    addressRegion: 'Karnataka',
    addressCountry: 'IN',
  },
};

const occasions = [
  { emoji: '🎂', label: 'Birthdays' },
  { emoji: '💞', label: 'Anniversaries' },
  { emoji: '👰', label: 'Bride-to-be' },
  { emoji: '🤵', label: 'Groom-to-be' },
  { emoji: '💍', label: 'Proposals' },
  { emoji: '🍼', label: 'Baby showers' },
];

const steps = [
  { n: 1, title: 'Pick a branch', body: 'Choose the Bangalore branch nearest you.' },
  { n: 2, title: 'Choose a theme & slot', body: 'Pick a decoration theme and a time that suits you.' },
  { n: 3, title: 'Add the extras', body: 'Cake, special decor and food combos — all in one flow.' },
  { n: 4, title: 'Confirm & celebrate', body: 'Pay the advance to lock your slot. Done!' },
];

const why = [
  { emoji: '🔒', title: 'Private & exclusive', body: 'The whole theatre is yours for your slot — no strangers, no sharing.' },
  { emoji: '✨', title: 'Curated decor themes', body: 'Hand-set celebration themes at every branch, ready for your moment.' },
  { emoji: '⚡', title: 'Book in minutes', body: 'Request a slot online and pay the advance to confirm. No account needed.' },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section
    class="bg-festive-animated relative -mx-4 overflow-hidden rounded-3xl px-6 py-16 text-center text-white shadow-lg sm:py-20"
  >
    <div class="pointer-events-none absolute left-6 top-8 text-4xl animate-float" aria-hidden="true">🎉</div>
    <div class="pointer-events-none absolute right-8 top-16 text-3xl animate-float" style="animation-delay:1s" aria-hidden="true">🎈</div>
    <div class="pointer-events-none absolute bottom-10 left-12 text-3xl animate-float" style="animation-delay:2s" aria-hidden="true">🎂</div>
    <h1 class="mx-auto max-w-3xl text-4xl font-extrabold leading-tight drop-shadow sm:text-5xl animate-fade-up">
      Celebrate every moment on the big screen
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-white/90 animate-fade-up" style="animation-delay:0.1s">
      Private theatres for birthdays, anniversaries, bride-to-be, groom-to-be and
      every celebration — with curated decoration themes across three Bangalore
      branches.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3 animate-fade-up" style="animation-delay:0.2s">
      <a
        href="/locations"
        class="rounded-full bg-white px-7 py-3 font-semibold text-brand shadow transition hover:scale-105"
      >
        Start booking
      </a>
      <a
        href="/about"
        class="rounded-full border-2 border-white/80 px-7 py-3 font-semibold text-white transition hover:bg-white/10"
      >
        About us
      </a>
    </div>
  </section>

  <!-- Occasions -->
  <section class="py-12">
    <h2 class="text-center text-2xl font-bold text-gray-900">For every occasion</h2>
    <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
      {
        occasions.map((o) => (
          <li class="reveal card-lift rounded-2xl bg-white p-5 text-center shadow-sm">
            <div class="text-4xl">{o.emoji}</div>
            <p class="mt-2 text-sm font-semibold text-gray-700">{o.label}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- How it works -->
  <section class="py-12">
    <h2 class="text-center text-2xl font-bold text-gray-900">How it works</h2>
    <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s) => (
          <li class="reveal card-lift rounded-2xl bg-white p-6 shadow-sm">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-festive-hero font-bold text-white">
              {s.n}
            </div>
            <h3 class="mt-4 font-semibold text-gray-900">{s.title}</h3>
            <p class="mt-1 text-sm text-gray-600">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Branches preview -->
  <section class="py-12">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900">Our branches</h2>
      <a href="/locations" class="text-sm font-semibold text-brand hover:underline">
        See all →
      </a>
    </div>
    <p class="mt-2 max-w-2xl text-gray-600">
      Each branch has its own set of curated decoration themes. Pick one to see
      its themes and available slots.
    </p>
    <div class="mt-6">
      <!-- Live branch cards (runtime fetch). Fine for a few branches; switch to
           a "see all" layout if the count grows. -->
      <BranchPreview client:visible />
    </div>
  </section>

  <!-- Why us -->
  <section class="py-12">
    <h2 class="text-center text-2xl font-bold text-gray-900">Why Cinematic Celebration</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        why.map((w) => (
          <div class="reveal card-lift rounded-2xl bg-white p-6 text-center shadow-sm">
            <div class="text-4xl">{w.emoji}</div>
            <h3 class="mt-3 font-semibold text-gray-900">{w.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{w.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="my-12 rounded-3xl bg-festive-hero px-6 py-12 text-center text-white shadow-lg">
    <h2 class="text-3xl font-extrabold drop-shadow">Ready to celebrate?</h2>
    <p class="mx-auto mt-3 max-w-xl text-white/90">
      Pick your branch, choose a theme, and reserve your private theatre in
      minutes.
    </p>
    <a
      href="/locations"
      class="mt-6 inline-block rounded-full bg-white px-8 py-3 font-semibold text-brand shadow transition hover:scale-105"
    >
      Book your celebration
    </a>
  </section>
</Base>
