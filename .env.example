# Cinematic Celebration — root environment file.
# Copy to New_Application/.env and fill in real values. NEVER commit .env.
# Consumed by deploy/docker-compose.yml (api env_file + postgres + backups).

# --- Environment ---
# Trial: staging   |   After cutover: production
ENVIRONMENT=production

# --- Deployment: API hostname + image ---
# API_HOST is the TLS hostname Caddy serves (see deploy/Caddyfile).
#   Trial:      api-staging.cinematiccelebration.in
#   Production: api.cinematiccelebration.in
API_HOST=api.cinematiccelebration.in
# API_IMAGE is the prebuilt api image tag to pull (built off-box on a 1 GB VPS).
#   e.g. ghcr.io/<org>/cineceleb-api:latest  (leave default for local build)
API_IMAGE=cineceleb-api:local

# --- PostgreSQL (container + app) ---
POSTGRES_USER=cinematic
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cinematic
# App DB URL (points at the compose 'postgres' service on the internal network).
DATABASE_URL=postgresql+psycopg://cinematic:change-me-strong-password@postgres:5432/cinematic
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Auth / JWT ---
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# --- CORS (explicit allowlist; comma-separated; never *) ---
# Trial: the two Cloudflare Pages *.pages.dev URLs.
# Production: the real origins below.
CORS_ALLOWED_ORIGINS=https://cinematiccelebration.in,https://admin.cinematiccelebration.in

# --- Auth cookie policy ---
# Trial (admin *.pages.dev and API api-staging. are DIFFERENT registrable
# domains -> cross-site): COOKIE_SAMESITE=none, COOKIE_SECURE=true.
# Production (admin. and api. share cinematiccelebration.in): COOKIE_SAMESITE=lax,
# COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# --- Booking lifecycle ---
PENDING_HOLD_MINUTES=120

# --- Manual payment (Phase 1) ---
MANUAL_UPI_VPA=cinematic@upi

# --- Email (transactional SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=bookings@cinematiccelebration.in
BUSINESS_EMAIL=owner@cinematiccelebration.in

# --- Cloudflare R2 (S3-compatible) ---
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=cinematic-public
R2_PRIVATE_BUCKET=cinematic-backups
IMG_CDN_DOMAIN=img.cinematiccelebration.in

# --- Backups (deploy/backup/backup.sh uses the AWS CLI against R2) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
